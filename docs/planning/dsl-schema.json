{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Dify DSL Next Workflow",
    "type": "object",
    "required": [
        "name",
        "nodes"
    ],
    "properties": {
        "name": {
            "type": "string",
            "description": "Name of the workflow"
        },
        "description": {
            "type": "string",
            "description": "Description of what the workflow does"
        },
        "version": {
            "type": "string",
            "description": "Version of the DSL",
            "default": "1.0"
        },
        "nodes": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/Node"
            },
            "description": "List of nodes in the workflow"
        }
    },
    "definitions": {
        "Node": {
            "type": "object",
            "required": [
                "id",
                "type"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
                    "description": "Unique identifier for the node"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "generate",
                        "tool",
                        "parallel",
                        "selector",
                        "noop",
                        "group"
                    ]
                },
                "next": {
                    "type": "string",
                    "description": "ID of the next node to execute (optional, defaults to next in list)"
                },
                "visibility": {
                    "type": "string",
                    "enum": [
                        "public",
                        "silent",
                        "ephemeral"
                    ],
                    "default": "public",
                    "description": "Controls user visibility vs memory persistence"
                },
                "memory_policy": {
                    "type": "string",
                    "enum": [
                        "result_only",
                        "full",
                        "summary"
                    ],
                    "default": "result_only",
                    "description": "Controls how local scope memory merges back to global"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "generate"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "model": {
                                "type": "string",
                                "description": "LLM model identifier (e.g., 'gpt-4', 'gpt-3.5-turbo')"
                            },
                            "system_prompt": {
                                "type": "string",
                                "description": "System prompt for the LLM. **Supports CEL expressions** using ${ } syntax for dynamic content. Example: 'You are a helpful assistant for ${ inputs.user_name }'"
                            },
                            "temperature": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 2,
                                "description": "Sampling temperature for the LLM"
                            },
                            "max_tokens": {
                                "type": "integer",
                                "description": "Maximum number of tokens to generate"
                            },
                            "context_mode": {
                                "type": "string",
                                "enum": [
                                    "all",
                                    "recent",
                                    "none"
                                ],
                                "default": "all",
                                "description": "How to include conversation history"
                            }
                        },
                        "required": [
                            "model"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "tool"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "tool_name": {
                                "type": "string",
                                "description": "Name of the tool to execute"
                            },
                            "parameters": {
                                "type": "object",
                                "description": "Parameters to pass to the tool. **Values support CEL expressions** using ${ } syntax. Example: { \"city\": \"${ inputs.query }\" }",
                                "additionalProperties": true
                            }
                        },
                        "required": [
                            "tool_name"
                        ],
                        "description": "Executes a registered tool with given parameters"
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "parallel"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "branches": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "nodes": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/Node"
                                            }
                                        }
                                    },
                                    "required": [
                                        "nodes"
                                    ]
                                },
                                "description": "List of parallel execution branches"
                            },
                            "reducer": {
                                "description": "Optional node to reduce/merge branch results",
                                "$ref": "#/definitions/Node"
                            }
                        },
                        "required": [
                            "branches"
                        ],
                        "description": "Executes multiple branches in parallel"
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "selector"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "cases": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "if": {
                                            "type": "string",
                                            "description": "**CEL boolean expression** to evaluate. Example: 'inputs.score >= 60 && inputs.score < 90'. Access: inputs.*, nodes.*.output, nodes.*.data.*, vars.*"
                                        },
                                        "next": {
                                            "type": "string",
                                            "description": "Node ID to jump to if condition is true"
                                        }
                                    },
                                    "required": [
                                        "if",
                                        "next"
                                    ]
                                },
                                "description": "List of conditional branches evaluated in order"
                            }
                        },
                        "required": [
                            "cases"
                        ],
                        "description": "Conditional branching using CEL expressions"
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "group"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "nodes": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/Node"
                                },
                                "description": "Nodes to execute within this group scope"
                            }
                        },
                        "required": [
                            "nodes"
                        ],
                        "description": "Groups nodes with local memory scope"
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "noop"
                            }
                        }
                    },
                    "then": {
                        "description": "No-operation node, useful for placeholders or testing"
                    }
                }
            ]
        }
    }
}
