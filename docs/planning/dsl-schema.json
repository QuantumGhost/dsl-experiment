{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "dsl-exp Workflow",
    "type": "object",
    "required": [
        "name",
        "nodes"
    ],
    "properties": {
        "name": {
            "type": "string",
            "description": "Name of the workflow"
        },
        "description": {
            "type": "string",
            "description": "Description of what the workflow does"
        },
        "version": {
            "type": "string",
            "description": "Version of the DSL"
        },
        "nodes": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/Node"
            },
            "description": "List of nodes in the workflow"
        }
    },
    "definitions": {
        "Node": {
            "type": "object",
            "required": [
                "id",
                "type"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9[a-zA-Z_]_]+$",
                    "description": "Unique identifier for the node"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "generate",
                        "tool",
                        "parallel",
                        "selector",
                        "noop",
                        "group"
                    ]
                },
                "next": {
                    "type": "string",
                    "description": "ID of the next node to execute (optional, defaults to next in list)"
                },
                "visibility": {
                    "type": "string",
                    "enum": [
                        "public",
                        "silent",
                        "ephemeral"
                    ],
                    "default": "public",
                    "description": "Controls user visibility vs memory persistence"
                },
                "memory_policy": {
                    "type": "string",
                    "enum": [
                        "result_only",
                        "full",
                        "summary"
                    ],
                    "default": "result_only",
                    "description": "Controls how local scope memory merges back to global"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "generate"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "model": {
                                "type": "string"
                            },
                            "system_prompt": {
                                "type": "string"
                            },
                            "temperature": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "model"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "tool"
                            }
                        }
                    },
                    "then": {
                        "description": "Executes a tool call generated by a previous message"
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "parallel"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "branches": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "nodes": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/Node"
                                            }
                                        }
                                    },
                                    "required": [
                                        "nodes"
                                    ]
                                }
                            },
                            "reducer": {
                                "description": "Optional node to reduce/merge branch results",
                                "$ref": "#/definitions/Node"
                            }
                        },
                        "required": [
                            "branches"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "selector"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "model": {
                                "type": "string"
                            },
                            "system_prompt": {
                                "type": "string"
                            },
                            "options": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "case": {
                                            "type": "string",
                                            "description": "Description of the case for LLM matching"
                                        },
                                        "next": {
                                            "type": "string",
                                            "description": "Node ID to jump to"
                                        }
                                    },
                                    "required": [
                                        "case",
                                        "next"
                                    ]
                                }
                            }
                        },
                        "required": [
                            "options"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "group"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "nodes": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/Node"
                                }
                            }
                        },
                        "required": [
                            "nodes"
                        ]
                    }
                }
            ]
        }
    }
}